# Local only. Copy to .env.local — never commit real keys.
# These NEXT_PUBLIC_* values are baked in at `npm run build` (S3 cannot inject them later).
NEXT_PUBLIC_SITE_URL=https://abhishekn.dev
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_HTRACKER_ALLOWED_EMAIL=YOUR_GOOGLE_EMAIL@gmail.com

# Deploy (optional overrides; defaults match the existing bucket)
# S3_BUCKET=abhishek-portfolio-static-assets
# AWS_REGION=us-east-1
# CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
