NODE_ENV=development
PORT=3001
POSTGRES_USER=squat
POSTGRES_PASSWORD=squat
POSTGRES_DB=squat
POSTGRES_PORT=5433
DATABASE_URL=postgresql://squat:squat@localhost:5433/squat?schema=public
TEST_DATABASE_URL=postgresql://squat:squat@localhost:5433/squat_test?schema=public
# Browser Origin header, not a path. Trailing slashes are stripped, but scheme
# and host must match exactly. Production needs the deployed frontend origin:
# CORS_ORIGINS=https://abhishekn.dev,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# OAuth client ID from Google Cloud Console. Must be the same value the frontend
# builds with, because it is checked as the ID token audience. The client *secret*
# is not used: Squat verifies ID tokens rather than running an OAuth code exchange.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Signs Squat's own session tokens. At least 32 characters, unique per environment.
# Rotating it signs every user out. Generate with: openssl rand -base64 48
SESSION_JWT_SECRET=change-me-to-at-least-32-random-characters
