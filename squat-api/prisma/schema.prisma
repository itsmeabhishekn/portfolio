generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  QUADS
  HAMSTRINGS
  GLUTES
  ADDUCTORS
  CALVES
  ARMS
  CORE
  FULL_BODY
}

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  OTHER
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  googleSub   String   @unique @map("google_sub")
  email       String   @unique
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  programs        Program[]
  workoutSessions WorkoutSession[]

  @@map("users")
}

model Program {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  name              String
  description       String
  isActive          Boolean  @default(true) @map("is_active")
  nextWorkoutId     String?  @map("next_workout_id") @db.Uuid
  overrideWorkoutId String?  @map("override_workout_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts        Workout[]
  nextWorkout     Workout?  @relation("ProgramNextWorkout", fields: [nextWorkoutId], references: [id], onDelete: SetNull)
  overrideWorkout Workout?  @relation("ProgramOverrideWorkout", fields: [overrideWorkoutId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isActive])
  @@index([nextWorkoutId])
  @@index([overrideWorkoutId])
  @@map("programs")
}

model Workout {
  id        String   @id @default(uuid()) @db.Uuid
  programId String   @map("program_id") @db.Uuid
  name      String
  notes     String?
  order     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  program             Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  workoutExercises    WorkoutExercise[]
  sessions            WorkoutSession[]
  nextForPrograms     Program[]         @relation("ProgramNextWorkout")
  overrideForPrograms Program[]         @relation("ProgramOverrideWorkout")

  @@unique([programId, order])
  @@index([programId])
  @@map("workouts")
}

model Exercise {
  id                      String        @id @default(uuid()) @db.Uuid
  name                    String        @unique
  description             String?
  primaryMuscleGroup      MuscleGroup   @map("primary_muscle_group")
  secondaryMuscleGroups   MuscleGroup[] @map("secondary_muscle_groups")
  equipment               Equipment
  catalogKey              String?       @unique @map("catalog_key")
  region                  String?
  focus                   String?
  targetSubdivision       String?       @map("target_subdivision")
  movementPattern         String?       @map("movement_pattern")
  mechanics               String?
  aclFriendly             Boolean?      @map("acl_friendly")
  shoulderImpingementRisk String?       @map("shoulder_impingement_risk")
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workoutExercises WorkoutExercise[]
  sessionExercises SessionExercise[]

  @@map("exercises")
}

model WorkoutExercise {
  id             String   @id @default(uuid()) @db.Uuid
  workoutId      String   @map("workout_id") @db.Uuid
  exerciseId     String   @map("exercise_id") @db.Uuid
  order          Int
  targetSets     Int      @map("target_sets")
  repMin         Int      @map("rep_min")
  repMax         Int      @map("rep_max")
  targetWeightKg Decimal? @map("target_weight_kg") @db.Decimal(6, 2)
  restSeconds    Int      @map("rest_seconds")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workout          Workout           @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise         Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sessionExercises SessionExercise[]

  @@unique([workoutId, order])
  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model WorkoutSession {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  workoutId   String                @map("workout_id") @db.Uuid
  status      WorkoutSessionStatus
  startedAt   DateTime              @map("started_at") @db.Timestamptz(3)
  completedAt DateTime?             @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout   Workout           @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  exercises SessionExercise[]

  @@index([userId])
  @@index([workoutId])
  @@index([status])
  @@index([userId, status])
  @@map("workout_sessions")
}

model SessionExercise {
  id                String   @id @default(uuid()) @db.Uuid
  sessionId         String   @map("session_id") @db.Uuid
  workoutExerciseId String   @map("workout_exercise_id") @db.Uuid
  exerciseId        String   @map("exercise_id") @db.Uuid
  order             Int
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  session         WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Restrict)
  exercise        Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets            Set[]

  @@unique([sessionId, order])
  @@index([sessionId])
  @@map("session_exercises")
}

model Set {
  id                String    @id @default(uuid()) @db.Uuid
  sessionExerciseId String    @map("session_exercise_id") @db.Uuid
  setNumber         Int       @map("set_number")
  weightKg          Decimal?  @map("weight_kg") @db.Decimal(6, 2)
  reps              Int?
  rpe               Decimal?  @db.Decimal(3, 1)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@unique([sessionExerciseId, setNumber])
  @@index([sessionExerciseId])
  @@map("sets")
}
