# Squat talks to squat-api and signs users in with Google. Both values are baked
# into the bundle at build time and both are public by design — the Google client
# *secret* is never used by this app and must never appear here.

VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# For a production build, put the deployed values in squat/.env.production:
# VITE_API_BASE_URL=https://api.example.com/api/v1
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
